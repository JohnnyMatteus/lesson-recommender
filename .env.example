# Copie para .env e ajuste. Valores abaixo são apenas para desenvolvimento local.
LR_REPOSITORY_BACKEND=memory          # memory | neo4j
LR_DATASET_PATH=data/dataset.json     # usado com o backend memory

LR_NEO4J_URI=bolt://localhost:7687
LR_NEO4J_USER=neo4j
LR_NEO4J_PASSWORD=dev-only-change-me

LR_EMBEDDINGS_BACKEND=hashing         # hashing | sentence-transformers (requer o extra)
LR_EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LR_EMBEDDINGS_DIMENSIONS=1024

LR_WEIGHT_CONTENT=0.5
LR_WEIGHT_COLLABORATIVE=0.4
LR_WEIGHT_POPULARITY=0.1
LR_NEIGHBORS=30

# Artefatos do modelo (índice de embeddings e relatórios versionados por data)
LR_ARTIFACTS_BACKEND=local            # local | s3 (MinIO localmente, S3 na AWS)
LR_ARTIFACTS_DIR=artifacts
LR_S3_ENDPOINT_URL=http://localhost:9000   # deixe vazio para usar o S3 real da AWS
LR_S3_BUCKET=lesson-recommender-artifacts
LR_S3_ACCESS_KEY=dev-only-minio
LR_S3_SECRET_KEY=dev-only-change-me
LR_S3_REGION=us-east-1

LR_LOG_LEVEL=INFO
LR_OTEL_SERVICE_NAME=lesson-recommender
# LR_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Portas publicadas pelo docker-compose (mude se houver conflito)
LR_API_PORT=8000
LR_NEO4J_HTTP_PORT=7474
LR_NEO4J_BOLT_PORT=7687
LR_MINIO_API_PORT=9000
LR_MINIO_CONSOLE_PORT=9001
LR_JAEGER_UI_PORT=16686
LR_OTLP_HTTP_PORT=4318
LR_PROMETHEUS_PORT=9090
